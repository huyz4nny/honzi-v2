@{
    ViewData["Title"] = "Trang chủ";
}

<div class="main-content">
    <!-- Hero Section -->
    <section class="bg-hero" style="padding-top: 3.5rem; padding-bottom: 3.5rem;">
        <div class="container">
            @if (ViewBag.DueCount != null && ViewBag.DueCount > 0)
            {
                <div class="mb-8 p-4 rounded-2xl d-flex align-items-center justify-content-between flex-wrap gap-4 shadow-sm" style="background: linear-gradient(135deg, #fef9c3 0%, #fef08a 100%); border: 1px solid #fde047;">
                    <div class="d-flex align-items-center gap-3">
                        <div style="font-size: 2.2rem; line-height: 1;">🧠</div>
                        <div>
                            <div class="fw-bold" style="color: #713f12; font-size: 1.05rem;">
                                Chu kỳ ôn tập ngắt quãng Spaced Repetition (SRS)
                            </div>
                            <div style="color: #854d0e; font-size: 0.9rem;">
                                Bạn có <strong style="color: #b45309; font-size: 1rem;">@ViewBag.DueCount từ vựng</strong> đã đến hạn cần ôn lại theo chu kỳ Leitner để chống quên lãng!
                            </div>
                        </div>
                    </div>
                    <a asp-controller="Progress" asp-action="Index" class="btn btn-primary btn-sm shadow-lift" style="white-space: nowrap;">
                        <i class="fa-solid fa-rotate me-1"></i> Ôn tập ngay (@ViewBag.DueCount)
                    </a>
                </div>
            }

            <div class="d-grid md-grid-cols-2 align-items-center gap-10">
                <div>
                    <span class="badge badge-primary px-3 py-1 text-xs font-semibold uppercase tracking-wider" style="display: inline-flex; align-items: center; gap: 6px;">
                        <i class="fa-solid fa-wand-magic-sparkles" style="font-size: 0.75rem;"></i> 480+ TỪ VỰNG HSK 1 → HSK 6 & THUẬT TOÁN SRS (.NET 9)
                    </span>
                    
                    <h1 class="mt-4 text-ink fw-extrabold tracking-tight" style="font-size: 2.75rem; line-height: 1.2;">
                        Học <span class="font-hanzi text-primary">汉字</span> theo cách<br class="d-none sm-block" /> khoa học & hiệu quả nhất
                    </h1>
                    
                    <p class="mt-4 text-muted" style="font-size: 1.05rem; max-width: 32rem; line-height: 1.65;">
                        Kết hợp Flashcard 3D, luyện nghe chép chính tả (Dictation Listening), phát âm chuẩn giọng bản xứ và <strong>Thuật toán lặp lại ngắt quãng (Spaced Repetition System - Leitner 5 Hộp)</strong> giúp ghi nhớ vĩnh viễn.
                    </p>
                    
                    <div class="mt-6 d-flex flex-wrap gap-3">
                        <a asp-controller="Listening" asp-action="Index" class="btn btn-primary btn-lg shadow-lift"
                           data-require-auth="@(User.Identity?.IsAuthenticated != true ? "true" : null)"
                           data-feature-name="@(User.Identity?.IsAuthenticated != true ? "Luyện nghe chép chính tả" : null)">
                            <i class="fa-solid fa-headphones me-2"></i> Luyện nghe ngay
                        </a>
                        <a asp-controller="Flashcard" asp-action="Index" class="btn btn-outline btn-lg"
                           data-require-auth="@(User.Identity?.IsAuthenticated != true ? "true" : null)"
                           data-feature-name="@(User.Identity?.IsAuthenticated != true ? "Flashcard 3D" : null)">
                            Lật Flashcard
                        </a>
                        <a asp-controller="Words" asp-action="Index" class="btn btn-outline btn-lg"
                           data-require-auth="@(User.Identity?.IsAuthenticated != true ? "true" : null)"
                           data-feature-name="@(User.Identity?.IsAuthenticated != true ? "Kho từ vựng HSK" : null)">
                            Kho từ vựng (@(ViewBag.TotalWords ?? 483))
                        </a>
                    </div>
                    
                    <div class="mt-7 d-flex flex-wrap gap-6 text-muted" style="font-size: 0.875rem;">
                        <span class="d-inline-flex align-items-center gap-2">
                            <i class="fa-solid fa-book-open text-primary"></i> @(ViewBag.TotalWords ?? 483)+ Từ vựng chuẩn HSK 1 - 6
                        </span>
                        <span class="d-inline-flex align-items-center gap-2">
                            <i class="fa-solid fa-brain text-primary"></i> Thuật toán Leitner SRS
                        </span>
                        <span class="d-inline-flex align-items-center gap-2">
                            <i class="fa-solid fa-headphones text-primary"></i> Luyện nghe chép từ & câu
                        </span>
                    </div>
                </div>
                
                <div class="text-center">
                    <img src="~/assets/hero-ink.jpg" 
                         alt="Nét bút thư pháp Trung Hoa màu đỏ" 
                         class="rounded-3xl shadow-lift mx-auto" 
                         style="max-width: 360px; width: 100%; border: 1px solid rgba(232, 226, 216, 0.8);" />
                </div>
            </div>
        </div>
    </section>

    <!-- HSK Level Selection Section -->
    <section class="home-section">
        <div class="container">
            <div class="d-flex flex-wrap align-items-end justify-content-between gap-3 mb-6">
                <div>
                    <h2 class="text-ink fw-extrabold tracking-tight" style="font-size: 1.75rem;">Chọn cấp độ HSK</h2>
                    <p class="mt-1 text-muted" style="font-size: 0.9rem;">
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <span>Tiến độ học tập và luyện nghe được lưu tự động vào tài khoản <strong>@User.Identity.Name</strong>.</span>
                        }
                        else
                        {
                            <span>Đăng nhập để lưu tiến độ học tập và lịch sử làm bài kiểm tra trên mọi thiết bị.</span>
                        }
                    </p>
                </div>
                @if (User.Identity?.IsAuthenticated != true)
                {
                    <a asp-controller="Auth" asp-action="Login" class="btn btn-outline btn-sm">
                        Đăng nhập / Đăng ký
                    </a>
                }
            </div>

            <!-- Level Cards Grid -->
            <div class="d-grid sm-grid-cols-2 lg-grid-cols-3 gap-4">
                @{
                    var levels = new[] {
                        new { Hsk = 1, Title = "HSK 1", Desc = "150 từ nền tảng — chào hỏi, gia đình, số đếm", Badge = "Nền tảng" },
                        new { Hsk = 2, Title = "HSK 2", Desc = "300 từ — giao tiếp cơ bản, mua sắm, thời gian", Badge = "Cơ bản" },
                        new { Hsk = 3, Title = "HSK 3", Desc = "600 từ — đời sống hàng ngày, học tập, du lịch", Badge = "Sơ cấp" },
                        new { Hsk = 4, Title = "HSK 4", Desc = "1200 từ — thảo luận chủ đề đa dạng, công việc", Badge = "Trung cấp" },
                        new { Hsk = 5, Title = "HSK 5", Desc = "2500 từ — đọc báo, xem phim, thuyết trình", Badge = "Cao cấp" },
                        new { Hsk = 6, Title = "HSK 6", Desc = "5000 từ — hiểu sâu, diễn đạt tự nhiên như người bản xứ", Badge = "Thành thạo" }
                    };
                }

                @foreach (var lvl in levels)
                {
                    <div class="card shadow-card">
                        <div class="d-flex align-items-center justify-content-between">
                            <h3 class="text-ink fw-bold" style="font-size: 1.25rem;">@lvl.Title</h3>
                            <span class="badge badge-secondary">@lvl.Badge</span>
                        </div>
                        <p class="mt-2 text-muted" style="font-size: 0.875rem; min-height: 2.5rem;">
                            @lvl.Desc
                        </p>
                        <div class="progress-container mt-3">
                            <div class="progress-bar-fill" style="width: @(lvl.Hsk == 1 ? "100" : (lvl.Hsk == 2 ? "70" : "40"))%;"></div>
                        </div>
                        
                        <div class="mt-4 d-grid gap-2">
                            <div class="d-flex gap-2">
                                <a asp-controller="Flashcard" asp-action="Index" asp-route-hskLevel="@lvl.Hsk" class="btn btn-outline btn-sm flex-1"
                                   data-require-auth="@(User.Identity?.IsAuthenticated != true ? "true" : null)"
                                   data-feature-name="@(User.Identity?.IsAuthenticated != true ? $"Flashcard cấp độ {lvl.Hsk}" : null)">
                                    <i class="fa-solid fa-layer-group me-1"></i> Flashcard
                                </a>
                                <a asp-controller="Quiz" asp-action="Index" asp-route-hskLevel="@lvl.Hsk" class="btn btn-outline btn-sm flex-1"
                                   data-require-auth="@(User.Identity?.IsAuthenticated != true ? "true" : null)"
                                   data-feature-name="@(User.Identity?.IsAuthenticated != true ? $"Quiz kiểm tra cấp độ {lvl.Hsk}" : null)">
                                    <i class="fa-solid fa-clipboard-question me-1"></i> Quiz
                                </a>
                            </div>
                            <a asp-controller="Listening" asp-action="Index" asp-route-hskLevel="@lvl.Hsk" class="btn btn-primary btn-sm w-full"
                               data-require-auth="@(User.Identity?.IsAuthenticated != true ? "true" : null)"
                               data-feature-name="@(User.Identity?.IsAuthenticated != true ? $"Luyện nghe cấp độ {lvl.Hsk}" : null)">
                                <i class="fa-solid fa-headphones me-1"></i> Luyện nghe cấp độ @lvl.Hsk
                            </a>
                        </div>
                    </div>
                }
            </div>
        </div>
    </section>

    <!-- Spaced Repetition System Section -->
    <section class="home-section" style="background: var(--background); border-top: 1px solid var(--border);">
        <div class="container">
            <!-- Section Header Centered -->
            <div class="text-center mb-10">
                <span class="badge badge-primary px-3 py-1 text-xs font-semibold uppercase tracking-wider">
                    <i class="fa-solid fa-brain me-1"></i> Khoa Học Ghi Nhớ
                </span>
                <h2 class="text-ink fw-extrabold mt-3 tracking-tight" style="font-size: 2.15rem;">
                    Thuật Toán Lặp Lại Ngắt Quãng (Spaced Repetition – Leitner)
                </h2>
                <p class="text-muted mt-2 mx-auto" style="max-width: 680px; font-size: 1rem; line-height: 1.65;">
                    Dựa trên nghiên cứu về <strong>Đường cong quên lãng Ebbinghaus</strong>, hệ thống tự động tính chu kỳ nhắc ôn tập theo 5 Hộp ghi nhớ, giúp chuyển hóa từ vựng ngắn hạn vào trí nhớ dài hạn.
                </p>
            </div>

            <!-- Two Symmetrical Equal-Height Cards -->
            <div class="d-grid md-grid-cols-2 gap-6 align-items-stretch">
                <!-- Left Column: 5 Leitner Boxes -->
                <div class="card shadow-card p-5 d-flex flex-column justify-content-between h-100" style="background: #ffffff; border: 1px solid var(--border); border-radius: var(--radius-xl);">
                    <div>
                        <div class="d-flex align-items-center gap-3 pb-3 mb-4" style="border-bottom: 1px solid var(--border);">
                            <span style="display: flex; align-items: center; justify-content: center; width: 38px; height: 38px; border-radius: var(--radius-md); background: rgba(194, 59, 43, 0.08); color: var(--primary); font-size: 1.1rem; flex-shrink: 0;">
                                <i class="fa-solid fa-boxes-stacked"></i>
                            </span>
                            <div>
                                <h3 class="fw-bold text-ink mb-0" style="font-size: 1.15rem;">5 Cấp Độ Chu Kỳ Ôn Tập</h3>
                                <span class="text-muted" style="font-size: 0.8rem;">Từ vựng tự động thăng cấp theo chu kỳ 1 → 30 ngày</span>
                            </div>
                        </div>

                        <div class="d-flex flex-column gap-2">
                            <!-- Hộp 1 -->
                            <div class="leitner-box-row d-flex align-items-center justify-content-between gap-2.5">
                                <div class="d-flex align-items-center gap-2.5" style="min-width: 0;">
                                    <span class="badge badge-primary leitner-badge">Hộp 1</span>
                                    <div style="min-width: 0;">
                                        <div class="fw-bold text-ink leitner-title" style="font-size: 0.875rem; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;">Từ mới & Vừa sai</div>
                                        <div class="text-muted leitner-desc" style="font-size: 0.75rem; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;">Củng cố phản xạ tức thì</div>
                                    </div>
                                </div>
                                <span class="badge badge-secondary leitner-tag">
                                    <i class="fa-regular fa-calendar-check me-1 text-primary"></i> Ôn sau 1 ngày
                                </span>
                            </div>

                            <!-- Hộp 2 -->
                            <div class="leitner-box-row d-flex align-items-center justify-content-between gap-2.5">
                                <div class="d-flex align-items-center gap-2.5" style="min-width: 0;">
                                    <span class="badge badge-secondary leitner-badge">Hộp 2</span>
                                    <div style="min-width: 0;">
                                        <div class="fw-bold text-ink leitner-title" style="font-size: 0.875rem; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;">Ghi nhớ cơ bản</div>
                                        <div class="text-muted leitner-desc" style="font-size: 0.75rem; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;">Bắt đầu nhận diện mặt chữ</div>
                                    </div>
                                </div>
                                <span class="badge badge-secondary leitner-tag">
                                    <i class="fa-regular fa-calendar-check me-1 text-primary"></i> Ôn sau 3 ngày
                                </span>
                            </div>

                            <!-- Hộp 3 -->
                            <div class="leitner-box-row d-flex align-items-center justify-content-between gap-2.5">
                                <div class="d-flex align-items-center gap-2.5" style="min-width: 0;">
                                    <span class="badge badge-secondary leitner-badge">Hộp 3</span>
                                    <div style="min-width: 0;">
                                        <div class="fw-bold text-ink leitner-title" style="font-size: 0.875rem; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;">Ghi nhớ trung hạn</div>
                                        <div class="text-muted leitner-desc" style="font-size: 0.75rem; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;">Phản xạ phát âm & Pinyin tốt</div>
                                    </div>
                                </div>
                                <span class="badge badge-secondary leitner-tag">
                                    <i class="fa-regular fa-calendar-check me-1 text-primary"></i> Ôn sau 7 ngày
                                </span>
                            </div>

                            <!-- Hộp 4 -->
                            <div class="leitner-box-row d-flex align-items-center justify-content-between gap-2.5">
                                <div class="d-flex align-items-center gap-2.5" style="min-width: 0;">
                                    <span class="badge badge-secondary leitner-badge">Hộp 4</span>
                                    <div style="min-width: 0;">
                                        <div class="fw-bold text-ink leitner-title" style="font-size: 0.875rem; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;">Ghi nhớ vững chắc</div>
                                        <div class="text-muted leitner-desc" style="font-size: 0.75rem; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;">Vận dụng trôi chảy vào câu</div>
                                    </div>
                                </div>
                                <span class="badge badge-secondary leitner-tag">
                                    <i class="fa-regular fa-calendar-check me-1 text-primary"></i> Ôn sau 14 ngày
                                </span>
                            </div>

                            <!-- Hộp 5 -->
                            <div class="leitner-box-row d-flex align-items-center justify-content-between gap-2.5">
                                <div class="d-flex align-items-center gap-2.5" style="min-width: 0;">
                                    <span class="badge badge-secondary leitner-badge">Hộp 5</span>
                                    <div style="min-width: 0;">
                                        <div class="fw-bold text-ink leitner-title" style="font-size: 0.875rem; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;">Thành thạo vĩnh viễn</div>
                                        <div class="text-muted leitner-desc" style="font-size: 0.75rem; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;">In sâu vào trí nhớ dài hạn</div>
                                    </div>
                                </div>
                                <span class="badge badge-secondary leitner-tag">
                                    <i class="fa-regular fa-calendar-check me-1 text-primary"></i> Ôn sau 30 ngày
                                </span>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Right Column: Why it works -->
                <div class="card shadow-card p-5 d-flex flex-column justify-content-between h-100" style="background: #ffffff; border: 1px solid var(--border); border-radius: var(--radius-xl);">
                    <div>
                        <div class="d-flex align-items-center gap-3 pb-3 mb-4" style="border-bottom: 1px solid var(--border);">
                            <span style="display: flex; align-items: center; justify-content: center; width: 38px; height: 38px; border-radius: var(--radius-md); background: rgba(194, 59, 43, 0.08); color: var(--primary); font-size: 1.1rem; flex-shrink: 0;">
                                <i class="fa-solid fa-chart-line"></i>
                            </span>
                            <div>
                                <h3 class="fw-bold text-ink mb-0" style="font-size: 1.15rem;">Tại Sao Phương Pháp Này Hiệu Quả?</h3>
                                <span class="text-muted" style="font-size: 0.8rem;">Cơ chế khoa học đã được kiểm chứng</span>
                            </div>
                        </div>

                        <ul class="d-flex flex-column gap-3.5 text-muted mb-0" style="list-style: none; padding-left: 0; font-size: 0.9rem; line-height: 1.6;">
                            <li class="d-flex align-items-start gap-2.5">
                                <i class="fa-solid fa-circle-check text-primary mt-1" style="font-size: 0.95rem; flex-shrink: 0;"></i>
                                <div>
                                    <strong class="text-ink">Chống học vẹt:</strong> Không nhồi nhét hàng trăm từ trong 1 ngày rồi quên sạch sau 1 tuần.
                                </div>
                            </li>
                            <li class="d-flex align-items-start gap-2.5">
                                <i class="fa-solid fa-circle-check text-primary mt-1" style="font-size: 0.95rem; flex-shrink: 0;"></i>
                                <div>
                                    <strong class="text-ink">Tập trung điểm yếu:</strong> Từ nào bạn hay gõ sai hoặc quên sẽ tự động quay về Hộp 1 để rèn luyện nhiều hơn.
                                </div>
                            </li>
                            <li class="d-flex align-items-start gap-2.5">
                                <i class="fa-solid fa-circle-check text-primary mt-1" style="font-size: 0.95rem; flex-shrink: 0;"></i>
                                <div>
                                    <strong class="text-ink">Tiết kiệm 80% thời gian:</strong> Chỉ ôn tập những từ "sắp quên" theo đúng thời điểm vàng thay vì lật lại cả nghìn từ.
                                </div>
                            </li>
                            <li class="d-flex align-items-start gap-2.5">
                                <i class="fa-solid fa-circle-check text-primary mt-1" style="font-size: 0.95rem; flex-shrink: 0;"></i>
                                <div>
                                    <strong class="text-ink">Tích hợp toàn diện:</strong> Đồng bộ liền mạch khi lật Flashcard 3D, làm bài Quiz trắc nghiệm và Luyện nghe chính tả.
                                </div>
                            </li>
                        </ul>
                    </div>

                    <div class="mt-5 pt-4 text-center" style="border-top: 1px solid var(--border);">
                        <a asp-controller="Progress" asp-action="Index" class="btn btn-primary btn-md shadow-lift w-full"
                           data-require-auth="@(User.Identity?.IsAuthenticated != true ? "true" : null)"
                           data-feature-name="@(User.Identity?.IsAuthenticated != true ? "Hàng đợi Spaced Repetition" : null)">
                            <i class="fa-solid fa-list-check me-2"></i> Xem hàng đợi ôn tập SRS của bạn
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Why Choose HonziGo & Core Value Pillars Section -->
    <section class="home-section bg-secondary" style="border-top: 1px solid var(--border);">
        <div class="container">
            <div class="text-center mb-10">
                <span class="badge badge-primary px-3 py-1 text-xs font-semibold uppercase tracking-wider">
                    <i class="fa-solid fa-trophy me-1"></i> Giá trị khác biệt
                </span>
                <h2 class="text-ink fw-extrabold tracking-tight mt-3" style="font-size: 2.15rem;">
                    Tại Sao Bạn Nên Chọn HonziGo?
                </h2>
                <p class="text-muted mt-2 mx-auto" style="max-width: 650px; font-size: 1rem; line-height: 1.6;">
                    Bản so sánh thực tế chỉ ra lý do tại sao phương pháp học đa giác quan kết hợp thuật toán SRS tại HonziGo giúp bạn học nhanh gấp 3 lần so với phương pháp truyền thống.
                </p>
            </div>

            <!-- Comparison Matrix Grid: Traditional vs HonziGo -->
            <div class="d-grid md-grid-cols-2 gap-6 align-items-stretch">
                
                <!-- Left Column: Cách học truyền thống -->
                <div class="card p-5 shadow-card d-flex flex-column h-100" style="border: 1px solid var(--border); background: #faf8f5; border-radius: var(--radius-xl);">
                    <div class="d-flex align-items-center gap-3 pb-3 mb-4" style="border-bottom: 1px solid var(--border);">
                        <span style="display: flex; align-items: center; justify-content: center; width: 40px; height: 40px; border-radius: 10px; background: rgba(122, 114, 110, 0.12); color: var(--muted-foreground); font-size: 1.15rem; flex-shrink: 0;">
                            <i class="fa-solid fa-circle-xmark"></i>
                        </span>
                        <div>
                            <h3 class="fw-bold text-ink mb-0" style="font-size: 1.15rem;">Cách Học Truyền Thống</h3>
                            <span class="text-muted" style="font-size: 0.8rem;">Sách vở, chép tay hoặc Flashcard thụ động</span>
                        </div>
                    </div>

                    <ul class="d-flex flex-column gap-3.5 text-muted mb-auto" style="list-style: none; padding-left: 0; font-size: 0.885rem; line-height: 1.55;">
                        <li class="d-flex align-items-start gap-2.5">
                            <span class="comp-icon-col"><i class="fa-solid fa-xmark text-muted" style="font-size: 0.95rem;"></i></span>
                            <div>
                                <strong class="text-ink">Học vẹt, nhanh quên:</strong>
                                Nhồi nhét hàng chục từ trong ngày rồi quên sạch sau 1 tuần vì thiếu chu kỳ ôn ngắt quãng khoa học.
                            </div>
                        </li>
                        <li class="d-flex align-items-start gap-2.5">
                            <span class="comp-icon-col"><i class="fa-solid fa-xmark text-muted" style="font-size: 0.95rem;"></i></span>
                            <div>
