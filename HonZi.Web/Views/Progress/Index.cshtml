@model HonZi.Web.Models.ViewModels.ProgressDashboardViewModel
@{
    ViewData["Title"] = "Thống kê tiến độ";
}

<div class="main-content py-10">
    <div class="container">
        <!-- Title & Subtitle -->
        <h1 class="text-ink fw-extrabold tracking-tight" style="font-size: 1.875rem;">
            Thống kê học tập cá nhân
        </h1>
        <p class="mt-1 text-muted" style="font-size: 0.9rem;">
            Theo dõi từ vựng đã thuộc, kết quả kiểm tra trắc nghiệm và lịch sử luyện nghe chép chính tả.
        </p>

        @if (User.Identity?.IsAuthenticated != true)
        {
            <div class="alert-box alert-info mt-4">
                <i class="fa-solid fa-circle-info text-primary"></i>
                <div>
                    Bạn đang ở chế độ khách. Hãy 
                    <a asp-controller="Auth" asp-action="Login" class="fw-bold text-primary">Đăng nhập</a> 
                    để lưu tiến độ học tập và biểu đồ thống kê cá nhân.
                </div>
            </div>
        }

        <!-- 4 Highlight Metric Cards -->
        <div class="d-grid sm-grid-cols-2 lg-grid-cols-4 gap-4 mt-6">
            <div class="card-plain shadow-card p-6">
                <i class="fa-solid fa-graduation-cap text-primary" style="font-size: 1.5rem;"></i>
                <p class="mt-3 text-ink fw-extrabold" style="font-size: 2rem; line-height: 1;">
                    @Model.Stats.MasteredCount / @Model.Stats.TotalWords
                </p>
                <p class="text-muted mt-1 mb-0" style="font-size: 0.875rem;">Từ vựng đã thuộc</p>
            </div>

            <div class="card-plain shadow-card p-6">
                <i class="fa-solid fa-book-open-reader text-warning" style="font-size: 1.5rem; color: #ca8a04;"></i>
                <p class="mt-3 text-ink fw-extrabold" style="font-size: 2rem; line-height: 1; color: #ca8a04;">
                    @Model.Stats.LearningCount từ
                </p>
                <p class="text-muted mt-1 mb-0" style="font-size: 0.875rem;">Đang trong quá trình học</p>
            </div>

            <div class="card-plain shadow-card p-6">
                <i class="fa-solid fa-clipboard-question text-info" style="font-size: 1.5rem; color: #0284c7;"></i>
                <p class="mt-3 text-ink fw-extrabold" style="font-size: 2rem; line-height: 1; color: #0284c7;">
                    @Model.Stats.TotalQuizzesTaken bài
                </p>
                <p class="text-muted mt-1 mb-0" style="font-size: 0.875rem;">Bài Quiz đã hoàn thành</p>
            </div>

            <div class="card-plain shadow-card p-6">
                <i class="fa-solid fa-headphones text-primary" style="font-size: 1.5rem;"></i>
                <p class="mt-3 text-ink fw-extrabold" style="font-size: 2rem; line-height: 1; color: var(--primary);">
                    @Model.Stats.TotalListeningTaken lượt
                </p>
                <p class="text-muted mt-1 mb-0" style="font-size: 0.875rem;">Bài Luyện nghe đã làm</p>
            </div>
        </div>

        <!-- 6 HSK Breakdown Cards -->
        <div class="card-plain shadow-card mt-6 p-6">
            <h2 class="text-ink fw-bold mb-4" style="font-size: 1.15rem;">Tiến độ theo cấp độ HSK</h2>
            
            <div class="d-grid sm-grid-cols-2 lg-grid-cols-6 gap-3">
                @for (int lvl = 1; lvl <= 6; lvl++)
                {
                    var hasData = Model.Stats.HskProgress.TryGetValue(lvl, out var hskStat);
                    int mastered = hasData ? hskStat.Mastered : 0;
                    int total = hasData ? hskStat.Total : 0;
                    double pct = total > 0 ? (double)mastered / total * 100 : 0;

                    <div class="p-4 rounded-xl bg-secondary text-center">
                        <span class="badge badge-primary mb-2">HSK @lvl</span>
                        <div class="text-ink fw-extrabold" style="font-size: 1.25rem;">
                            @mastered / @total
                        </div>
                        <p class="text-muted" style="font-size: 0.75rem; margin-bottom: 0.5rem;">từ đã thuộc</p>
                        
                        <div class="progress-container" style="height: 5px;">
                            <div class="progress-bar-fill success" style="width: @pct%;"></div>
                        </div>
                    </div>
                }
            </div>
        </div>

        <!-- Tabs Container -->
        <div class="card-plain shadow-card mt-6 p-6">
            <div class="tab-header mb-4" style="border-bottom: 1px solid #e2e8f0; display: flex; gap: 8px; flex-wrap: wrap;">
                <button type="button" class="tab-btn active btn btn-primary btn-sm" data-tab-target="tabSrs">
                    <i class="fa-solid fa-brain me-1"></i> Đến hạn ôn tập SRS (@Model.DueWordsCount)
                </button>
                <button type="button" class="tab-btn btn btn-outline btn-sm" data-tab-target="tabReview">
                    <i class="fa-solid fa-triangle-exclamation text-danger me-1"></i> Từ hay sai (@Model.NeedsReviewWords.Count)
                </button>
                <button type="button" class="tab-btn btn btn-outline btn-sm" data-tab-target="tabListening">
                    <i class="fa-solid fa-headphones text-primary me-1"></i> Lịch sử Luyện nghe (@Model.RecentListenings.Count)
                </button>
                <button type="button" class="tab-btn btn btn-outline btn-sm" data-tab-target="tabQuiz">
                    <i class="fa-solid fa-clock-rotate-left me-1"></i> Lịch sử Quiz (@Model.RecentQuizzes.Count)
                </button>
            </div>

            <!-- Tab SRS: Đến Hạn Ôn Tập -->
            <div class="tab-content-panel active" id="tabSrs">
                <div class="d-flex align-items-center justify-content-between p-3 mb-4 rounded-xl" style="background: rgba(22, 163, 74, 0.08); border: 1px solid rgba(22, 163, 74, 0.2);">
                    <div>
                        <div class="fw-bold" style="color: #15803d; font-size: 0.95rem;">
                            <i class="fa-solid fa-lightbulb me-1"></i> Thuật toán ngắt quãng Leitner / SM-2:
                        </div>
                        <span class="text-muted" style="font-size: 0.825rem;">
                            Hệ thống tự động xếp lịch ôn tập theo khoảng cách (1 ngày -> 3 ngày -> 7 ngày -> 14 ngày -> 30 ngày) chống lại đường cong quên lãng Ebbinghaus.
                        </span>
                    </div>
                    @if (Model.DueWords.Any())
                    {
                        <a asp-controller="Flashcard" asp-action="Index" asp-route-srsMode="true" class="btn btn-primary btn-sm shadow-lift" style="background: #16a34a; border-color: #16a34a; white-space: nowrap;">
                            <i class="fa-solid fa-brain me-1"></i> Ôn tất cả ngay
                        </a>
                    }
                </div>

                @if (Model.DueWords.Any())
                {
                    <ul class="word-list-group">
                        @foreach (var up in Model.DueWords)
                        {
                            <li class="word-list-item d-flex align-items-center justify-content-between p-3" style="border-bottom: 1px solid #f1f5f9;">
                                <div class="d-flex align-items-center gap-3">
                                    <span class="font-hanzi text-ink fw-bold" style="font-size: 1.75rem;">@up.Word.Hanzi</span>
                                    <div>
                                        <div class="d-flex align-items-center gap-2">
                                            <span class="text-primary fw-bold">@up.Word.Pinyin</span>
                                            <span class="badge badge-secondary">HSK @up.Word.HskLevel</span>
                                        </div>
                                        <div class="text-muted" style="font-size: 0.85rem;">@up.Word.MeaningVi</div>
                                    </div>
                                </div>
                                <div class="d-flex align-items-center gap-2">
                                    <span class="badge" style="background: #fef3c7; color: #92400e;">
                                        Đúng: @up.CorrectCount | Sai: @up.WrongCount
                                    </span>
                                    <a asp-controller="Flashcard" asp-action="Index" asp-route-hskLevel="@up.Word.HskLevel" asp-route-srsMode="true" class="btn btn-outline btn-sm">
                                        Ôn từ này
                                    </a>
                                </div>
                            </li>
                        }
                    </ul>
                }
                else
                {
                    <p class="text-muted text-center py-6 mb-0">Hôm nay bạn chưa có từ nào đến hạn ôn tập. Hãy học thêm từ mới hoặc quay lại sau nhé!</p>
                }
            </div>

            <!-- Tab 2: Từ Cần Ôn Tập (Hay Sai) -->
            <div class="tab-content-panel" id="tabReview" style="display: none;">
                @if (Model.NeedsReviewWords.Any())
                {
                    <ul class="word-list-group">
                        @foreach (var up in Model.NeedsReviewWords)
                        {
                            <li class="word-list-item d-flex align-items-center justify-content-between p-3" style="border-bottom: 1px solid #f1f5f9;">
                                <div class="d-flex align-items-center gap-3">
                                    <span class="font-hanzi text-ink fw-bold" style="font-size: 1.75rem;">@up.Word.Hanzi</span>
                                    <div>
                                        <div class="text-primary fw-bold">@up.Word.Pinyin</div>
                                        <div class="text-muted" style="font-size: 0.85rem;">@up.Word.MeaningVi</div>
                                    </div>
                                </div>
                                <div class="d-flex align-items-center gap-3">
                                    <span class="badge badge-secondary" style="color: #dc2626; background: rgba(220, 38, 38, 0.1);">
                                        Sai @up.WrongCount lần
                                    </span>
                                    <button type="button" class="btn btn-ghost btn-icon" onclick="speak('@up.Word.Hanzi')" title="Phát âm">
                                        <i class="fa-solid fa-volume-high text-primary"></i>
                                    </button>
                                </div>
                            </li>
                        }
                    </ul>
                }
                else
                {
                    <p class="text-muted text-center py-6 mb-0">Tuyệt vời! Hiện tại bạn không có từ nào bị đánh dấu chưa thuộc.</p>
                }
            </div>

            <!-- Tab 2: Lịch Sử Luyện Nghe -->
            <div class="tab-content-panel" id="tabListening" style="display: none;">
                @if (Model.RecentListenings.Any())
                {
                    <div class="table-responsive">
                        <table class="table" style="width: 100%;">
                            <thead>
                                <tr style="border-bottom: 2px solid #e2e8f0; text-align: left; font-size: 0.85rem; color: #64748b;">
                                    <th style="padding: 0.75rem;">Thời gian</th>
                                    <th style="padding: 0.75rem;">Cấp độ</th>
                                    <th style="padding: 0.75rem;">Nội dung</th>
                                    <th style="padding: 0.75rem;">Kiểu gõ</th>
                                    <th style="padding: 0.75rem;">Điểm số</th>
                                    <th style="padding: 0.75rem;">Độ chính xác</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var l in Model.RecentListenings)
                                {
                                    <tr style="border-bottom: 1px solid #f1f5f9; font-size: 0.9rem;">
                                        <td style="padding: 0.75rem;">@l.TakenAt.ToString("dd/MM/yyyy HH:mm")</td>
                                        <td style="padding: 0.75rem;"><span class="badge badge-secondary">HSK @l.HskLevel</span></td>
                                        <td style="padding: 0.75rem;">@(l.ExerciseType == "Sentence" ? "Câu giao tiếp" : "Từ vựng")</td>
                                        <td style="padding: 0.75rem;">@(l.InputMode == "Pinyin" ? "Pinyin" : "Chữ Hán")</td>
                                        <td style="padding: 0.75rem; font-weight: bold; color: var(--primary);">@l.Score / @l.TotalQuestions</td>
                                        <td style="padding: 0.75rem;">
                                            <span class="badge @(l.AccuracyPercentage >= 80 ? "badge-primary" : "badge-secondary")">
                                                @l.AccuracyPercentage%
                                            </span>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <p class="text-muted text-center py-6 mb-0">Bạn chưa làm bài luyện nghe nào. Hãy thử ngay!</p>
                }
            </div>

            <!-- Tab 3: Lịch Sử Quiz -->
            <div class="tab-content-panel" id="tabQuiz" style="display: none;">
                @if (Model.RecentQuizzes.Any())
                {
                    <div class="table-responsive">
                        <table class="table" style="width: 100%;">
                            <thead>
                                <tr style="border-bottom: 2px solid #e2e8f0; text-align: left; font-size: 0.85rem; color: #64748b;">
                                    <th style="padding: 0.75rem;">Thời gian</th>
                                    <th style="padding: 0.75rem;">Cấp độ</th>
                                    <th style="padding: 0.75rem;">Điểm số</th>
                                    <th style="padding: 0.75rem;">Đạt tỷ lệ</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var q in Model.RecentQuizzes)
                                {
                                    var pct = Math.Round((double)q.Score / q.TotalQuestions * 100, 0);
                                    <tr style="border-bottom: 1px solid #f1f5f9; font-size: 0.9rem;">
                                        <td style="padding: 0.75rem;">@q.TakenAt.ToString("dd/MM/yyyy HH:mm")</td>
                                        <td style="padding: 0.75rem;"><span class="badge badge-secondary">HSK @q.HskLevel</span></td>
                                        <td style="padding: 0.75rem; font-weight: bold; color: var(--primary);">@q.Score / @q.TotalQuestions</td>
                                        <td style="padding: 0.75rem;">
                                            <span class="badge @(pct >= 80 ? "badge-primary" : "badge-secondary")">
                                                @pct%
                                            </span>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <p class="text-muted text-center py-6 mb-0">Chưa có lịch sử làm bài kiểm tra quiz.</p>
                }
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
document.querySelectorAll('.tab-btn').forEach(btn => {
    btn.addEventListener('click', function() {
        var target = this.getAttribute('data-tab-target');
        document.querySelectorAll('.tab-btn').forEach(b => b.classList.remove('active', 'btn-primary'));
        document.querySelectorAll('.tab-content-panel').forEach(p => p.style.display = 'none');

        this.classList.add('active', 'btn-primary');
        document.getElementById(target).style.display = 'block';
    });
});
</script>
}
