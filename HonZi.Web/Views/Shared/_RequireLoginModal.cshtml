@if (User.Identity?.IsAuthenticated != true)
{
    <!-- Modal Yêu cầu đăng nhập khi chưa đăng nhập mà bấm vào các tính năng -->
    <div id="requireLoginModalBackdrop" class="modal-backdrop" style="background-color: rgba(31, 28, 29, 0.45); backdrop-filter: blur(6px); z-index: 10000;" onclick="handleRequireLoginBackdropClick(event)">
        <div class="modal-dialog" style="max-width: 480px; width: 92%; padding: 0; border-radius: var(--radius-2xl); overflow: hidden; position: relative; border: 1px solid var(--border); box-shadow: 0 25px 60px -15px rgba(31, 28, 29, 0.25); background: #ffffff;">
            
            <!-- Close Button -->
            <button type="button" onclick="closeRequireLoginModal()" style="position: absolute; top: 1.25rem; right: 1.25rem; background: transparent; border: none; color: var(--muted-foreground); width: 32px; height: 32px; border-radius: 50%; display: flex; align-items: center; justify-content: center; cursor: pointer; transition: all 0.2s; z-index: 2;" onmouseover="this.style.background='var(--secondary)'; this.style.color='var(--ink)';" onmouseout="this.style.background='transparent'; this.style.color='var(--muted-foreground)';" title="Đóng" aria-label="Đóng">
                <i class="fa-solid fa-xmark" style="font-size: 1.1rem;"></i>
            </button>

            <!-- Watermark character -->
            <div style="position: absolute; right: 1rem; top: 0.5rem; font-family: var(--font-hanzi, 'Noto Serif SC', serif); font-size: 6.5rem; font-weight: 900; color: var(--ink); opacity: 0.04; line-height: 1; pointer-events: none; user-select: none;">
                学
            </div>

            <!-- Top Header & Icon -->
            <div style="padding: 1.75rem 2rem 0.5rem; text-align: center; position: relative;">
                <div style="background: rgba(194, 59, 43, 0.08); color: var(--primary); border: 1px solid rgba(194, 59, 43, 0.18); width: 56px; height: 56px; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 1.4rem; margin: 1.5rem auto 0.75rem;">
                    <i class="fa-solid fa-lock"></i>
                </div>

                <h3 class="fw-extrabold text-ink mb-1.5" style="font-size: 1.35rem; letter-spacing: -0.01em;">
                    Yêu Cầu Đăng Nhập
                </h3>
                <p class="text-muted mb-0" style="font-size: 0.9rem; line-height: 1.5; padding: 0 0.5rem;" id="requireLoginDesc">
                    Bạn cần đăng nhập tài khoản để sử dụng tính năng này!
                </p>
            </div>

            <!-- Modal Content Body -->
            <div style="padding: 1.25rem 2rem 1.75rem;">
                <div class="p-3.5 rounded-xl mb-4 d-flex align-items-start gap-2.5" style="background: #faf8f5; border: 1px solid var(--border);">
                    <i class="fa-solid fa-circle-info text-primary mt-0.5" style="font-size: 1.05rem; flex-shrink: 0;"></i>
                    <div style="font-size: 0.85rem; color: var(--muted-foreground); line-height: 1.55;">
                        Các tính năng <strong class="text-ink">Luyện nghe chép chính tả</strong>, <strong class="text-ink">Flashcard 3D</strong>, <strong class="text-ink">Kiểm tra trắc nghiệm</strong>, <strong class="text-ink">Kho từ vựng</strong> và <strong class="text-ink">Thống kê tiến độ</strong> yêu cầu tài khoản học viên để lưu lại kết quả và tính chu kỳ ghi nhớ SRS.
                    </div>
                </div>

                <div class="d-grid gap-2.5">
                    <a id="requireLoginDirectBtn" href="/Auth/Login" class="btn btn-primary btn-lg w-full shadow-lift" style="font-size: 0.95rem; font-weight: 700; padding: 0.75rem 1rem;">
                        <i class="fa-solid fa-arrow-right-to-bracket me-2"></i> Đăng nhập ngay
                    </a>
                    
                    <a id="requireRegisterDirectBtn" href="/Auth/Register" class="btn btn-outline btn-md w-full" style="font-size: 0.9rem; font-weight: 600; padding: 0.65rem 1rem;">
                        <i class="fa-solid fa-user-plus me-2"></i> Tạo tài khoản mới miễn phí
                    </a>

                    <button type="button" onclick="closeRequireLoginModal()" class="btn btn-ghost btn-sm text-muted mt-1" style="font-size: 0.85rem;">
                        Để sau, tôi muốn xem tiếp trang chủ
                    </button>
                </div>
            </div>

            <!-- Footer Small Tip -->
            <div class="py-2.5 px-4 text-center text-muted" style="background: #faf8f5; border-top: 1px solid var(--border); font-size: 0.775rem;">
                <i class="fa-solid fa-shield-halved me-1 text-primary"></i> Đăng ký nhanh chỉ mất 30 giây, hoàn toàn miễn phí
            </div>
            
        </div>
    </div>

    <script>
        function requireLoginPrompt(featureName, targetUrl) {
            var modal = document.getElementById('requireLoginModalBackdrop');
            var dest = targetUrl || '/';

            if (!modal) {
                window.location.href = '/Auth/Login?ReturnUrl=' + encodeURIComponent(dest);
                return false;
            }

            var descElem = document.getElementById('requireLoginDesc');
            if (descElem) {
                if (featureName) {
                    descElem.innerHTML = 'Bạn cần đăng nhập tài khoản để sử dụng tính năng <strong class="text-ink">' + featureName + '</strong>!';
                } else {
                    descElem.textContent = 'Bạn cần đăng nhập tài khoản để sử dụng tính năng này!';
                }
            }

            var loginBtn = document.getElementById('requireLoginDirectBtn');
            if (loginBtn) {
                loginBtn.href = '/Auth/Login?ReturnUrl=' + encodeURIComponent(dest);
            }

            var regBtn = document.getElementById('requireRegisterDirectBtn');
            if (regBtn) {
                regBtn.href = '/Auth/Register?ReturnUrl=' + encodeURIComponent(dest);
            }

            modal.classList.add('show');
            return false;
        }

        function closeRequireLoginModal() {
            var modal = document.getElementById('requireLoginModalBackdrop');
            if (modal) modal.classList.remove('show');
        }

        function handleRequireLoginBackdropClick(event) {
            if (event.target && event.target.id === 'requireLoginModalBackdrop') {
                closeRequireLoginModal();
            }
        }

        // Tự động bắt sự kiện click trên các nút có data-require-auth="true"
        document.addEventListener('DOMContentLoaded', function() {
            document.addEventListener('click', function(e) {
                var target = e.target.closest('[data-require-auth="true"]');
                if (target) {
                    e.preventDefault();
                    var featureName = target.getAttribute('data-feature-name') || '';
                    var targetUrl = target.getAttribute('href') || '/';
                    requireLoginPrompt(featureName, targetUrl);
                }
            });
        });
    </script>
}
