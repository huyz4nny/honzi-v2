@if (User.Identity?.IsAuthenticated != true)
{
    <!-- Modal Yêu cầu đăng nhập khi chưa đăng nhập mà bấm vào các tính năng -->
    <style>
        .require-login-dialog {
            max-width: 440px;
            width: 100%;
        }
        .require-lock-icon {
            width: 48px;
            height: 48px;
            min-width: 48px;
            min-height: 48px;
            border-radius: 50%;
            background: rgba(194, 59, 43, 0.08);
            color: var(--primary);
            border: 1px solid rgba(194, 59, 43, 0.2);
            display: inline-flex;
            align-items: center;
            justify-content: center;
            font-size: 1.25rem;
            margin: 0 auto 0.75rem;
            box-shadow: 0 4px 12px rgba(194, 59, 43, 0.08);
        }
        .require-feature-box {
            background: #faf8f5;
            border: 1px solid var(--border);
            border-radius: var(--radius-lg);
            padding: 0.75rem 0.85rem;
            margin-bottom: 1rem;
            display: flex;
            align-items: flex-start;
            gap: 0.65rem;
        }
    </style>

    <div id="requireLoginModalBackdrop" class="modal-backdrop" onclick="handleRequireLoginBackdropClick(event)">
        <div class="modal-dialog modal-dialog-responsive require-login-dialog" role="dialog" aria-modal="true" aria-labelledby="requireLoginTitle">
            
            <!-- 1. Header cố định (modal-header-fixed) -->
            <div class="modal-header-fixed text-center" style="position: relative; padding: 1.5rem 1.25rem 0.75rem 1.25rem;">
                <!-- Close Button touch target (36x36px) -->
                <button type="button" class="modal-close-btn" onclick="closeRequireLoginModal()" title="Đóng" aria-label="Đóng" style="position: absolute; top: 0.75rem; right: 0.75rem;">
                    <i class="fa-solid fa-xmark"></i>
                </button>

                <!-- Icon khóa đỏ son 48x48px tròn thanh nhã -->
                <div class="require-lock-icon">
                    <i class="fa-solid fa-lock"></i>
                </div>

                <h3 id="requireLoginTitle" class="fw-extrabold text-ink mb-1" style="font-size: 1.25rem; letter-spacing: -0.01em;">
                    Yêu Cầu Đăng Nhập
                </h3>
                <p class="text-muted mb-0" id="requireLoginDesc" style="font-size: 0.85rem; line-height: 1.45; max-width: 320px; margin: 0 auto;">
                    Bạn cần đăng nhập tài khoản HonziGo để sử dụng tính năng này!
                </p>
            </div>

            <!-- 2. Thân modal cuộn được (modal-body-scrollable) -->
            <div class="modal-body-scrollable" style="padding: 0.85rem 1.25rem 1.25rem 1.25rem;">
                <!-- Hộp thông tin tính năng gọn gàng -->
                <div class="require-feature-box">
                    <i class="fa-solid fa-circle-info text-primary mt-0.5" style="font-size: 0.95rem; flex-shrink: 0;"></i>
                    <div style="font-size: 0.8rem; color: var(--muted-foreground); line-height: 1.45;">
                        Các tính năng <strong class="text-ink">Luyện nghe chép chính tả</strong>, <strong class="text-ink">Flashcard 3D</strong>, <strong class="text-ink">Kiểm tra trắc nghiệm</strong> và <strong class="text-ink">Thống kê</strong> yêu cầu tài khoản để lưu lại kết quả và tính chu kỳ ghi nhớ SRS.
                    </div>
                </div>

                <!-- Các nút hành động -->
                <div class="d-grid gap-2">
                    <a id="requireLoginDirectBtn" href="/Auth/Login" class="btn btn-primary btn-md w-full shadow-lift" style="font-size: 0.9rem; font-weight: 700; padding: 0.65rem 1rem; justify-content: center;">
                        <i class="fa-solid fa-arrow-right-to-bracket me-2"></i> Đăng nhập ngay
                    </a>
                    
                    <a id="requireRegisterDirectBtn" href="/Auth/Register" class="btn btn-outline btn-sm w-full" style="font-size: 0.85rem; font-weight: 600; padding: 0.55rem 1rem; justify-content: center;">
                        <i class="fa-solid fa-user-plus me-2"></i> Tạo tài khoản mới miễn phí
                    </a>

                    <button type="button" onclick="closeRequireLoginModal()" class="btn btn-ghost btn-sm text-muted mt-0.5" style="font-size: 0.8rem; padding: 0.35rem 0.5rem; justify-content: center;">
                        Để sau, tôi muốn xem tiếp trang chủ
                    </button>
                </div>
            </div>

            <!-- 3. Footer cố định (modal-footer-fixed): Thông điệp bảo mật 30 giây -->
            <div class="modal-footer-fixed py-2 px-3 text-center text-muted" style="background: #faf8f5; border-top: 1px solid var(--border); font-size: 0.775rem;">
                <i class="fa-solid fa-shield-halved me-1 text-primary"></i> Đăng ký nhanh chỉ mất 30 giây, hoàn toàn miễn phí
            </div>
            
        </div>
    </div>

    <script>
        function requireLoginPrompt(featureName, targetUrl) {
            var modal = document.getElementById('requireLoginModalBackdrop');
            var dest = targetUrl || '/';

            if (!modal) {
                window.location.href = '/Auth/Login?ReturnUrl=' + encodeURIComponent(dest);
                return false;
            }

            var descElem = document.getElementById('requireLoginDesc');
            if (descElem) {
                if (featureName) {
                    descElem.innerHTML = 'Bạn cần đăng nhập tài khoản HonziGo để sử dụng tính năng <strong class="text-ink">' + featureName + '</strong>!';
                } else {
                    descElem.textContent = 'Bạn cần đăng nhập tài khoản HonziGo để sử dụng tính năng này!';
                }
            }

            var loginBtn = document.getElementById('requireLoginDirectBtn');
            if (loginBtn) {
                loginBtn.href = '/Auth/Login?ReturnUrl=' + encodeURIComponent(dest);
            }

            var regBtn = document.getElementById('requireRegisterDirectBtn');
            if (regBtn) {
                regBtn.href = '/Auth/Register?ReturnUrl=' + encodeURIComponent(dest);
            }

            modal.classList.add('show');
            return false;
        }

        function closeRequireLoginModal() {
            var modal = document.getElementById('requireLoginModalBackdrop');
            if (modal) modal.classList.remove('show');
        }

        function handleRequireLoginBackdropClick(event) {
            if (event.target && event.target.id === 'requireLoginModalBackdrop') {
                closeRequireLoginModal();
            }
        }

        // Tự động bắt sự kiện click trên các nút có data-require-auth="true"
        document.addEventListener('DOMContentLoaded', function() {
            document.addEventListener('click', function(e) {
                var target = e.target.closest('[data-require-auth="true"]');
                if (target) {
                    e.preventDefault();
                    var featureName = target.getAttribute('data-feature-name') || '';
                    var targetUrl = target.getAttribute('href') || '/';
                    requireLoginPrompt(featureName, targetUrl);
                }
            });
        });
    </script>
}
