<!-- Modal Giới thiệu nền tảng HanziGo -->
<div id="welcomeModalBackdrop" class="modal-backdrop" style="background-color: rgba(15, 23, 42, 0.65); backdrop-filter: blur(8px); z-index: 9999;" onclick="handleWelcomeBackdropClick(event)">
    <div class="modal-dialog" style="max-width: 680px; width: 92%; padding: 0; border-radius: 1.5rem; overflow: hidden; position: relative; border: 1px solid rgba(194, 59, 43, 0.25); box-shadow: 0 25px 60px -15px rgba(0, 0, 0, 0.35); background: #ffffff;">
        
        <!-- Header Banner with Chinese Motif -->
        <div style="background: linear-gradient(135deg, #c23b2b 0%, #991b1b 100%); color: #ffffff; padding: 2rem 2rem 1.75rem 2rem; position: relative; overflow: hidden;">
            <!-- Watermark character -->
            <div style="position: absolute; right: 1rem; bottom: -1rem; font-family: var(--font-hanzi, 'Noto Serif SC', serif); font-size: 7.5rem; font-weight: 900; color: rgba(255, 255, 255, 0.08); line-height: 1; pointer-events: none; user-select: none;">
                汉
            </div>
            
            <div class="d-flex align-items-center justify-content-between mb-2">
                <span style="background: rgba(255, 255, 255, 0.2); backdrop-filter: blur(4px); padding: 0.3rem 0.75rem; border-radius: 9999px; font-size: 0.75rem; font-weight: 700; letter-spacing: 0.05em; text-transform: uppercase;">
                    <i class="fa-solid fa-wand-magic-sparkles me-1"></i> Nền Tảng Học Tiếng Trung Đột Phá
                </span>
                <button type="button" onclick="closeWelcomeModal()" style="background: rgba(255, 255, 255, 0.2); border: none; color: #ffffff; width: 32px; height: 32px; border-radius: 50%; display: flex; align-items: center; justify-content: center; cursor: pointer; transition: background 0.2s;" title="Đóng" aria-label="Đóng">
                    <i class="fa-solid fa-xmark" style="font-size: 1rem;"></i>
                </button>
            </div>
            
            <h2 class="text-white fw-extrabold tracking-tight mt-2 mb-1" style="font-size: 1.75rem; line-height: 1.25;">
                Chào mừng bạn đến với <span style="color: #fef08a; font-family: var(--font-hanzi, serif);">HanziGo</span>!
            </h2>
            <p style="color: rgba(255, 255, 255, 0.9); font-size: 0.925rem; margin-bottom: 0; max-width: 520px; line-height: 1.5;">
                Giải pháp học Hán ngữ toàn diện kết hợp công nghệ C# .NET 9, thuật toán Spaced Repetition (SRS) và phương pháp Luyện nghe chép chính tả (Dictation) hàng đầu.
            </p>
        </div>

        <!-- Body: 4 Feature Highlights Grid -->
        <div style="padding: 1.75rem 2rem 1.25rem 2rem;">
            <div class="d-grid sm-grid-cols-2 gap-3">
                
                <!-- Card 1: Dictation Listening -->
                <div class="p-3 rounded-xl" style="background: #fdf2f0; border: 1px solid rgba(194, 59, 43, 0.15);">
                    <div class="d-flex align-items-center gap-2 mb-1">
                        <span style="display: flex; align-items: center; justify-content: center; width: 30px; height: 30px; border-radius: 8px; background: var(--primary); color: #fff; font-size: 0.85rem;">
                            <i class="fa-solid fa-headphones"></i>
                        </span>
                        <h4 class="fw-bold text-ink mb-0" style="font-size: 0.95rem;">Luyện Nghe Chép Chính Tả</h4>
                    </div>
                    <p class="text-muted mb-0" style="font-size: 0.825rem; line-height: 1.45;">
                        Nghe audio giọng bản xứ và gõ lại Hán tự hoặc Pinyin. Thuật toán diffing đối chiếu từng ký tự giúp sửa lỗi sai ngay lập tức.
                    </p>
                </div>

                <!-- Card 2: Spaced Repetition (SRS) -->
                <div class="p-3 rounded-xl" style="background: #f0fdf4; border: 1px solid rgba(22, 163, 74, 0.2);">
                    <div class="d-flex align-items-center gap-2 mb-1">
                        <span style="display: flex; align-items: center; justify-content: center; width: 30px; height: 30px; border-radius: 8px; background: #16a34a; color: #fff; font-size: 0.85rem;">
                            <i class="fa-solid fa-brain"></i>
                        </span>
                        <h4 class="fw-bold text-ink mb-0" style="font-size: 0.95rem;">Thuật Toán SRS (Leitner 5 Hộp)</h4>
                    </div>
                    <p class="text-muted mb-0" style="font-size: 0.825rem; line-height: 1.45;">
                        Tự động tính chu kỳ nhắc ôn tập theo đường cong quên lãng (1 → 3 → 7 → 14 → 30 ngày), giúp ghi nhớ sâu vào trí nhớ dài hạn.
                    </p>
                </div>

                <!-- Card 3: 480+ HSK 1-6 Words -->
                <div class="p-3 rounded-xl" style="background: #fefce8; border: 1px solid rgba(234, 179, 8, 0.25);">
                    <div class="d-flex align-items-center gap-2 mb-1">
                        <span style="display: flex; align-items: center; justify-content: center; width: 30px; height: 30px; border-radius: 8px; background: #ca8a04; color: #fff; font-size: 0.85rem;">
                            <i class="fa-solid fa-book-open"></i>
                        </span>
                        <h4 class="fw-bold text-ink mb-0" style="font-size: 0.95rem;">480+ Từ Vựng HSK 1 - 6</h4>
                    </div>
                    <p class="text-muted mb-0" style="font-size: 0.825rem; line-height: 1.45;">
                        Phân cấp bài bản từ cơ bản đến cao cấp. 100% từ vựng có phiên âm, giải nghĩa chuẩn, câu ví dụ đời sống và dịch nghĩa hoàn chỉnh.
                    </p>
                </div>

                <!-- Card 4: Flashcard 3D & Quiz -->
                <div class="p-3 rounded-xl" style="background: #f0f9ff; border: 1px solid rgba(2, 132, 199, 0.2);">
                    <div class="d-flex align-items-center gap-2 mb-1">
                        <span style="display: flex; align-items: center; justify-content: center; width: 30px; height: 30px; border-radius: 8px; background: #0284c7; color: #fff; font-size: 0.85rem;">
                            <i class="fa-solid fa-layer-group"></i>
                        </span>
                        <h4 class="fw-bold text-ink mb-0" style="font-size: 0.95rem;">Flashcard 3D & Quiz Tính Giờ</h4>
                    </div>
                    <p class="text-muted mb-0" style="font-size: 0.825rem; line-height: 1.45;">
                        Thao tác lật thẻ 3 chiều mượt mà, kết hợp đề kiểm tra 10 câu ngẫu nhiên có đồng hồ bấm giờ rèn luyện phản xạ phòng thi.
                    </p>
                </div>

            </div>

            <!-- Quick tip bar -->
            <div class="mt-4 p-2.5 rounded-lg d-flex align-items-center gap-2" style="background: #f8fafc; border: 1px dashed #cbd5e1; font-size: 0.825rem; color: #475569;">
                <i class="fa-solid fa-lightbulb text-warning" style="font-size: 1rem;"></i>
                <span><strong>Mẹo học nhanh:</strong> Chỉ cần dành 15 phút mỗi ngày với tính năng <em>Luyện nghe chép chính tả</em>, bạn sẽ ghi nhớ mặt chữ gấp 3 lần cách chép tay truyền thống!</span>
            </div>
        </div>

        <!-- Footer Actions -->
        <div class="p-4" style="background: #faf8f5; border-top: 1px solid var(--border); display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 12px;">
            <label class="d-flex align-items-center gap-2" style="cursor: pointer; user-select: none; font-size: 0.85rem; color: var(--muted-foreground); margin-bottom: 0;">
                <input type="checkbox" id="dontShowWelcomeAgain" style="accent-color: var(--primary); width: 16px; height: 16px; cursor: pointer;">
                <span>Không hiển thị lại cửa sổ này</span>
            </label>

            <div class="d-flex align-items-center gap-2 ms-auto">
                <button type="button" onclick="closeWelcomeModal()" class="btn btn-outline btn-sm">
                    Khám phá trang chủ
                </button>
                @if (User.Identity?.IsAuthenticated == true)
                {
                    <a href="/Listening" class="btn btn-primary btn-sm shadow-lift" onclick="closeWelcomeModal()">
                        <i class="fa-solid fa-headphones me-1"></i> Luyện nghe thử ngay
                    </a>
                }
                else
                {
                    <a href="/Listening" data-require-auth="true" data-feature-name="Luyện nghe chép chính tả" class="btn btn-primary btn-sm shadow-lift" onclick="closeWelcomeModal()">
                        <i class="fa-solid fa-headphones me-1"></i> Luyện nghe thử ngay
                    </a>
                }
            </div>
        </div>
        
    </div>
</div>

<script>
    function openWelcomeModal(forceOpen) {
        var modal = document.getElementById('welcomeModalBackdrop');
        if (!modal) return;
        if (forceOpen) {
            modal.classList.add('show');
            return;
        }
        var seen = localStorage.getItem('hanzigo_welcome_dismissed_v2');
        if (!seen) {
            setTimeout(function() {
                modal.classList.add('show');
            }, 600);
        }
    }

    function closeWelcomeModal() {
        var modal = document.getElementById('welcomeModalBackdrop');
        if (!modal) return;
        var chk = document.getElementById('dontShowWelcomeAgain');
        if (chk && chk.checked) {
            localStorage.setItem('hanzigo_welcome_dismissed_v2', 'true');
        }
        modal.classList.remove('show');
    }

    function handleWelcomeBackdropClick(event) {
        if (event.target && event.target.id === 'welcomeModalBackdrop') {
            closeWelcomeModal();
        }
    }

    // Tự động mở khi trang tải xong (nếu bấm Giới thiệu thì luôn mở, ngược lại mở nếu chưa chọn bỏ qua)
    document.addEventListener('DOMContentLoaded', function() {
        var urlParams = new URLSearchParams(window.location.search);
        if (urlParams.get('intro') === '1') {
            openWelcomeModal(true);
        } else {
            openWelcomeModal(false);
        }
    });
</script>
