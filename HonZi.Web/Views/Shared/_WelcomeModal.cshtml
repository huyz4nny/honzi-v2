<!-- Modal Giới thiệu nền tảng HanziGo -->
<div id="welcomeModalBackdrop" class="modal-backdrop" style="background-color: rgba(31, 28, 29, 0.45); backdrop-filter: blur(6px); z-index: 9999;" onclick="handleWelcomeBackdropClick(event)">
    <div class="modal-dialog" style="max-width: 680px; width: 92%; padding: 0; border-radius: var(--radius-2xl); overflow: hidden; position: relative; border: 1px solid var(--border); box-shadow: 0 25px 60px -15px rgba(31, 28, 29, 0.25); background: #ffffff;">
        
        <!-- Header Banner with Hanzi Motif -->
        <div style="background: #faf8f5; border-bottom: 1px solid var(--border); padding: 1.75rem 2rem 1.5rem 2rem; position: relative; overflow: hidden;">
            <!-- Watermark character -->
            <div style="position: absolute; right: 1.25rem; bottom: -1rem; font-family: var(--font-hanzi, 'Noto Serif SC', serif); font-size: 7.5rem; font-weight: 900; color: var(--ink); opacity: 0.05; line-height: 1; pointer-events: none; user-select: none;">
                汉
            </div>
            
            <div class="d-flex align-items-center justify-content-between mb-2.5">
                <span class="badge badge-primary">
                    <i class="fa-solid fa-wand-magic-sparkles me-1"></i> Nền Tảng Học Tiếng Trung
                </span>
                <button type="button" onclick="closeWelcomeModal()" style="background: transparent; border: none; color: var(--muted-foreground); width: 32px; height: 32px; border-radius: 50%; display: flex; align-items: center; justify-content: center; cursor: pointer; transition: all 0.2s;" onmouseover="this.style.background='var(--secondary)'; this.style.color='var(--ink)';" onmouseout="this.style.background='transparent'; this.style.color='var(--muted-foreground)';" title="Đóng" aria-label="Đóng">
                    <i class="fa-solid fa-xmark" style="font-size: 1.1rem;"></i>
                </button>
            </div>
            
            <h2 class="fw-extrabold text-ink tracking-tight mb-1.5" style="font-size: 1.65rem; line-height: 1.3;">
                Chào mừng bạn đến với <span class="text-primary font-hanzi">HanziGo</span>!
            </h2>
            <p class="text-muted mb-0" style="font-size: 0.925rem; max-width: 530px; line-height: 1.55;">
                Giải pháp học Hán ngữ toàn diện kết hợp công nghệ C# .NET 9, thuật toán Spaced Repetition (SRS) và phương pháp Luyện nghe chép chính tả (Dictation) hàng đầu.
            </p>
        </div>

        <!-- Body: 4 Feature Highlights Grid -->
        <div style="padding: 1.5rem 2rem 1.25rem 2rem;">
            <div class="d-grid sm-grid-cols-2 gap-3">
                
                <!-- Card 1: Dictation Listening -->
                <div class="p-3 rounded-xl" style="background: #ffffff; border: 1px solid var(--border);">
                    <div class="d-flex align-items-center gap-2.5 mb-1.5">
                        <span style="display: flex; align-items: center; justify-content: center; width: 32px; height: 32px; border-radius: var(--radius-sm); background: rgba(194, 59, 43, 0.08); color: var(--primary); font-size: 0.875rem; flex-shrink: 0;">
                            <i class="fa-solid fa-headphones"></i>
                        </span>
                        <h4 class="fw-bold text-ink mb-0" style="font-size: 0.95rem;">Luyện Nghe Chép Chính Tả</h4>
                    </div>
                    <p class="text-muted mb-0" style="font-size: 0.825rem; line-height: 1.5;">
                        Nghe audio giọng bản xứ và gõ lại Hán tự hoặc Pinyin. Thuật toán diffing đối chiếu từng ký tự giúp sửa lỗi sai ngay lập tức.
                    </p>
                </div>

                <!-- Card 2: Spaced Repetition (SRS) -->
                <div class="p-3 rounded-xl" style="background: #ffffff; border: 1px solid var(--border);">
                    <div class="d-flex align-items-center gap-2.5 mb-1.5">
                        <span style="display: flex; align-items: center; justify-content: center; width: 32px; height: 32px; border-radius: var(--radius-sm); background: rgba(194, 59, 43, 0.08); color: var(--primary); font-size: 0.875rem; flex-shrink: 0;">
                            <i class="fa-solid fa-brain"></i>
                        </span>
                        <h4 class="fw-bold text-ink mb-0" style="font-size: 0.95rem;">Thuật Toán SRS (Leitner 5 Hộp)</h4>
                    </div>
                    <p class="text-muted mb-0" style="font-size: 0.825rem; line-height: 1.5;">
                        Tự động tính chu kỳ nhắc ôn tập theo đường cong quên lãng (1 → 3 → 7 → 14 → 30 ngày), giúp ghi nhớ sâu vào trí nhớ dài hạn.
                    </p>
                </div>

                <!-- Card 3: 480+ HSK 1-6 Words -->
                <div class="p-3 rounded-xl" style="background: #ffffff; border: 1px solid var(--border);">
                    <div class="d-flex align-items-center gap-2.5 mb-1.5">
                        <span style="display: flex; align-items: center; justify-content: center; width: 32px; height: 32px; border-radius: var(--radius-sm); background: rgba(194, 59, 43, 0.08); color: var(--primary); font-size: 0.875rem; flex-shrink: 0;">
                            <i class="fa-solid fa-book-open"></i>
                        </span>
                        <h4 class="fw-bold text-ink mb-0" style="font-size: 0.95rem;">480+ Từ Vựng HSK 1 - 6</h4>
                    </div>
                    <p class="text-muted mb-0" style="font-size: 0.825rem; line-height: 1.5;">
                        Phân cấp bài bản từ cơ bản đến cao cấp. 100% từ vựng có phiên âm, giải nghĩa chuẩn, câu ví dụ đời sống và dịch nghĩa hoàn chỉnh.
                    </p>
                </div>

                <!-- Card 4: Flashcard 3D & Quiz -->
                <div class="p-3 rounded-xl" style="background: #ffffff; border: 1px solid var(--border);">
                    <div class="d-flex align-items-center gap-2.5 mb-1.5">
                        <span style="display: flex; align-items: center; justify-content: center; width: 32px; height: 32px; border-radius: var(--radius-sm); background: rgba(194, 59, 43, 0.08); color: var(--primary); font-size: 0.875rem; flex-shrink: 0;">
                            <i class="fa-solid fa-layer-group"></i>
                        </span>
                        <h4 class="fw-bold text-ink mb-0" style="font-size: 0.95rem;">Flashcard 3D & Quiz Tính Giờ</h4>
                    </div>
                    <p class="text-muted mb-0" style="font-size: 0.825rem; line-height: 1.5;">
                        Thao tác lật thẻ 3 chiều mượt mà, kết hợp đề kiểm tra 10 câu ngẫu nhiên có đồng hồ bấm giờ rèn luyện phản xạ phòng thi.
                    </p>
                </div>

            </div>

            <!-- Quick tip bar -->
            <div class="mt-3 p-3 rounded-xl d-flex align-items-center gap-2.5" style="background: #faf8f5; border: 1px solid var(--border); font-size: 0.825rem; color: var(--muted-foreground);">
                <span style="display: flex; align-items: center; justify-content: center; width: 28px; height: 28px; border-radius: 50%; background: rgba(194, 59, 43, 0.08); color: var(--primary); flex-shrink: 0; font-size: 0.875rem;">
                    <i class="fa-solid fa-lightbulb"></i>
                </span>
                <span><strong class="text-ink">Mẹo học nhanh:</strong> Chỉ cần dành 15 phút mỗi ngày với tính năng <em>Luyện nghe chép chính tả</em>, bạn sẽ ghi nhớ mặt chữ gấp 3 lần cách chép tay truyền thống!</span>
            </div>
        </div>

        <!-- Footer Actions -->
        <div class="p-4" style="background: #faf8f5; border-top: 1px solid var(--border); display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 12px;">
            <label class="d-flex align-items-center gap-2" style="cursor: pointer; user-select: none; font-size: 0.85rem; color: var(--muted-foreground); margin-bottom: 0;">
                <input type="checkbox" id="dontShowWelcomeAgain" style="accent-color: var(--primary); width: 16px; height: 16px; cursor: pointer;">
                <span>Không hiển thị lại cửa sổ này</span>
            </label>

            <div class="d-flex align-items-center gap-2 ms-auto">
                <button type="button" onclick="closeWelcomeModal()" class="btn btn-outline btn-sm">
                    Khám phá trang chủ
                </button>
                @if (User.Identity?.IsAuthenticated == true)
                {
                    <a href="/Listening" class="btn btn-primary btn-sm shadow-lift" onclick="closeWelcomeModal()">
                        <i class="fa-solid fa-headphones me-1"></i> Luyện nghe thử ngay
                    </a>
                }
                else
                {
                    <a href="/Listening" data-require-auth="true" data-feature-name="Luyện nghe chép chính tả" class="btn btn-primary btn-sm shadow-lift" onclick="closeWelcomeModal()">
                        <i class="fa-solid fa-headphones me-1"></i> Luyện nghe thử ngay
                    </a>
                }
            </div>
        </div>
        
    </div>
</div>

<script>
    function openWelcomeModal(forceOpen) {
        var modal = document.getElementById('welcomeModalBackdrop');
        if (!modal) return;
        if (forceOpen) {
            modal.classList.add('show');
            return;
        }
        var seen = localStorage.getItem('hanzigo_welcome_dismissed_v2');
        if (!seen) {
            setTimeout(function() {
                modal.classList.add('show');
            }, 600);
        }
    }

    function closeWelcomeModal() {
        var modal = document.getElementById('welcomeModalBackdrop');
        if (!modal) return;
        var chk = document.getElementById('dontShowWelcomeAgain');
        if (chk && chk.checked) {
            localStorage.setItem('hanzigo_welcome_dismissed_v2', 'true');
        }
        modal.classList.remove('show');
    }

    function handleWelcomeBackdropClick(event) {
        if (event.target && event.target.id === 'welcomeModalBackdrop') {
            closeWelcomeModal();
        }
    }

    // Tự động mở khi trang tải xong (nếu bấm Giới thiệu thì luôn mở, ngược lại mở nếu chưa chọn bỏ qua)
    document.addEventListener('DOMContentLoaded', function() {
        var urlParams = new URLSearchParams(window.location.search);
        if (urlParams.get('intro') === '1') {
            openWelcomeModal(true);
        } else {
            openWelcomeModal(false);
        }
    });
</script>
