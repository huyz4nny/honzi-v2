<!-- Modal Giới thiệu nền tảng HonziGo -->
<style>
    .welcome-modal-dialog {
        max-width: 660px;
        width: 100%;
    }
    .welcome-modal-title {
        font-size: 1.35rem;
        line-height: 1.3;
    }
    .welcome-modal-desc {
        font-size: 0.875rem;
        line-height: 1.5;
        max-width: 530px;
    }
    .welcome-features-grid {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 0.75rem;
    }
    .welcome-feature-card {
        background: #ffffff;
        border: 1px solid var(--border);
        border-radius: var(--radius-lg);
        padding: 0.75rem 0.85rem;
        display: flex;
        flex-direction: column;
        justify-content: flex-start;
        height: 100%;
        transition: border-color 0.2s, box-shadow 0.2s;
    }
    .welcome-feature-card:hover {
        border-color: rgba(194, 59, 43, 0.35);
        box-shadow: 0 4px 12px rgba(31, 28, 29, 0.05);
    }
    .welcome-icon-box {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        background: rgba(194, 59, 43, 0.08);
        color: var(--primary);
        width: 30px;
        height: 30px;
        min-width: 30px;
        min-height: 30px;
        border-radius: var(--radius-sm);
        font-size: 0.85rem;
        flex-shrink: 0;
    }
    .welcome-tip-box {
        margin-top: 0.75rem;
        padding: 0.65rem 0.85rem;
        border-radius: var(--radius-md);
        background: #faf8f5;
        border: 1px solid var(--border);
        display: flex;
        align-items: flex-start;
        gap: 0.65rem;
        font-size: 0.8rem;
        line-height: 1.45;
        color: var(--muted-foreground);
    }
    .welcome-tip-icon {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 24px;
        height: 24px;
        min-width: 24px;
        min-height: 24px;
        border-radius: 50%;
        background: rgba(194, 59, 43, 0.08);
        color: var(--primary);
        font-size: 0.75rem;
        flex-shrink: 0;
        margin-top: 1px;
    }
    .welcome-footer-content {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 0.75rem;
        flex-wrap: wrap;
    }
    .welcome-footer-actions {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        margin-left: auto;
    }
    .welcome-checkbox-label {
        display: inline-flex;
        align-items: center;
        gap: 0.45rem;
        cursor: pointer;
        user-select: none;
        font-size: 0.825rem;
        color: var(--muted-foreground);
        margin-bottom: 0;
    }
    .welcome-checkbox-label input {
        accent-color: var(--primary);
        width: 15px;
        height: 15px;
        cursor: pointer;
        flex-shrink: 0;
    }

    @@media (max-width: 600px) {
        .welcome-features-grid {
            grid-template-columns: 1fr;
            gap: 0.55rem;
        }
        .welcome-modal-title {
            font-size: 1.15rem;
        }
        .welcome-modal-desc {
            font-size: 0.8rem;
            line-height: 1.4;
        }
        .welcome-footer-content {
            gap: 0.6rem;
        }
        .welcome-checkbox-label {
            width: 100%;
            font-size: 0.8rem;
        }
        .welcome-footer-actions {
            width: 100%;
            margin-left: 0;
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 0.5rem;
        }
        .welcome-footer-actions .btn {
            width: 100%;
            justify-content: center;
            text-align: center;
            padding: 0.45rem 0.4rem;
            font-size: 0.8rem;
            white-space: nowrap;
        }
    }
</style>

<div id="welcomeModalBackdrop" class="modal-backdrop" onclick="handleWelcomeBackdropClick(event)">
    <div class="modal-dialog modal-dialog-responsive welcome-modal-dialog" role="dialog" aria-modal="true" aria-labelledby="welcomeModalTitle">
        
        <!-- 1. Header cố định (modal-header-fixed) -->
        <div class="modal-header-fixed">
            <div class="d-flex align-items-center justify-content-between mb-2">
                <span class="badge badge-primary">
                    <i class="fa-solid fa-wand-magic-sparkles me-1"></i> Nền Tảng Học Tiếng Trung
                </span>
                <button type="button" class="modal-close-btn" onclick="closeWelcomeModal()" title="Đóng" aria-label="Đóng">
                    <i class="fa-solid fa-xmark"></i>
                </button>
            </div>
            
            <h2 id="welcomeModalTitle" class="fw-extrabold text-ink tracking-tight mb-1 welcome-modal-title">
                Chào mừng bạn đến với <span class="text-primary font-hanzi">HonziGo</span>!
            </h2>
            <p class="text-muted mb-0 welcome-modal-desc">
                Học Hán ngữ thông minh với thuật toán Spaced Repetition (SRS) và phương pháp Luyện nghe chép chính tả hàng đầu.
            </p>
        </div>

        <!-- 2. Thân modal cuộn được (modal-body-scrollable) -->
        <div class="modal-body-scrollable">
            <div class="welcome-features-grid">
                
                <!-- Card 1: Dictation Listening -->
                <div class="welcome-feature-card">
                    <div class="d-flex align-items-center gap-2 mb-1">
                        <span class="welcome-icon-box">
                            <i class="fa-solid fa-headphones"></i>
                        </span>
                        <h4 class="fw-bold text-ink mb-0" style="font-size: 0.9rem;">Luyện Nghe Chép Chính Tả</h4>
                    </div>
                    <p class="text-muted mb-0" style="font-size: 0.8rem; line-height: 1.45;">
                        Nghe audio giọng bản xứ và gõ lại Hán tự hoặc Pinyin. Thuật toán diffing đối chiếu từng ký tự giúp sửa lỗi sai ngay lập tức.
                    </p>
                </div>

                <!-- Card 2: Spaced Repetition (SRS) -->
                <div class="welcome-feature-card">
                    <div class="d-flex align-items-center gap-2 mb-1">
                        <span class="welcome-icon-box">
                            <i class="fa-solid fa-brain"></i>
                        </span>
                        <h4 class="fw-bold text-ink mb-0" style="font-size: 0.9rem;">Thuật Toán SRS (Leitner 5 Hộp)</h4>
                    </div>
                    <p class="text-muted mb-0" style="font-size: 0.8rem; line-height: 1.45;">
                        Tự động tính chu kỳ nhắc ôn theo đường cong quên lãng (1 → 3 → 7 → 14 → 30 ngày), giúp ghi nhớ sâu vào trí nhớ dài hạn.
                    </p>
                </div>

                <!-- Card 3: 480+ HSK 1-6 Words -->
                <div class="welcome-feature-card">
                    <div class="d-flex align-items-center gap-2 mb-1">
                        <span class="welcome-icon-box">
                            <i class="fa-solid fa-book-open"></i>
                        </span>
                        <h4 class="fw-bold text-ink mb-0" style="font-size: 0.9rem;">480+ Từ Vựng HSK 1 - 6</h4>
                    </div>
                    <p class="text-muted mb-0" style="font-size: 0.8rem; line-height: 1.45;">
                        Phân cấp bài bản từ cơ bản đến cao cấp. 100% từ vựng có phiên âm, giải nghĩa chuẩn, câu ví dụ đời sống và dịch nghĩa.
                    </p>
                </div>

                <!-- Card 4: Flashcard 3D & Quiz -->
                <div class="welcome-feature-card">
                    <div class="d-flex align-items-center gap-2 mb-1">
                        <span class="welcome-icon-box">
                            <i class="fa-solid fa-layer-group"></i>
                        </span>
                        <h4 class="fw-bold text-ink mb-0" style="font-size: 0.9rem;">Flashcard 3D & Quiz Tính Giờ</h4>
                    </div>
                    <p class="text-muted mb-0" style="font-size: 0.8rem; line-height: 1.45;">
                        Thao tác lật thẻ 3 chiều mượt mà, kết hợp đề thi 10 câu ngẫu nhiên có đồng hồ bấm giờ rèn luyện phản xạ phòng thi.
                    </p>
                </div>

            </div>

            <!-- Hộp Mẹo học nhanh: Nhỏ gọn, thanh nhã -->
            <div class="welcome-tip-box">
                <span class="welcome-tip-icon">
                    <i class="fa-solid fa-lightbulb"></i>
                </span>
                <div>
                    <strong class="text-ink">Mẹo học nhanh:</strong> Chỉ cần dành 15 phút mỗi ngày với tính năng <em>Luyện nghe chép chính tả</em>, bạn sẽ ghi nhớ mặt chữ gấp 3 lần cách chép tay truyền thống!
                </div>
            </div>
        </div>

        <!-- 3. Footer cố định (modal-footer-fixed) -->
        <div class="modal-footer-fixed">
            <div class="welcome-footer-content">
                <label class="welcome-checkbox-label">
                    <input type="checkbox" id="dontShowWelcomeAgain">
                    <span>Không hiển thị lại</span>
                </label>

                <div class="welcome-footer-actions">
                    <button type="button" onclick="closeWelcomeModal()" class="btn btn-outline btn-sm">
                        Khám phá trang chủ
                    </button>
                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <a href="/Listening" class="btn btn-primary btn-sm shadow-lift" onclick="closeWelcomeModal()">
                            <i class="fa-solid fa-headphones me-1"></i> Luyện nghe thử ngay
                        </a>
                    }
                    else
                    {
                        <a href="/Listening" data-require-auth="true" data-feature-name="Luyện nghe chép chính tả" class="btn btn-primary btn-sm shadow-lift" onclick="closeWelcomeModal()">
                            <i class="fa-solid fa-headphones me-1"></i> Luyện nghe thử ngay
                        </a>
                    }
                </div>
            </div>
        </div>
        
    </div>
</div>

<script>
    function openWelcomeModal(forceOpen) {
        var modal = document.getElementById('welcomeModalBackdrop');
        if (!modal) return;
        if (forceOpen) {
            modal.classList.add('show');
            return;
        }
        var seen = localStorage.getItem('honzigo_welcome_dismissed_v2');
        if (!seen) {
            setTimeout(function() {
                modal.classList.add('show');
            }, 600);
        }
    }

    function closeWelcomeModal() {
        var modal = document.getElementById('welcomeModalBackdrop');
        if (!modal) return;
        var chk = document.getElementById('dontShowWelcomeAgain');
        if (chk && chk.checked) {
            localStorage.setItem('honzigo_welcome_dismissed_v2', 'true');
        }
        modal.classList.remove('show');
    }

    function handleWelcomeBackdropClick(event) {
        if (event.target && event.target.id === 'welcomeModalBackdrop') {
            closeWelcomeModal();
        }
    }

    // Tự động mở khi trang tải xong (nếu bấm Giới thiệu thì luôn mở, ngược lại mở nếu chưa chọn bỏ qua)
    document.addEventListener('DOMContentLoaded', function() {
        var urlParams = new URLSearchParams(window.location.search);
        if (urlParams.get('intro') === '1') {
            openWelcomeModal(true);
        } else {
            openWelcomeModal(false);
        }
    });
</script>
