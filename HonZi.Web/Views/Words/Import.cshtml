@model HonZi.Web.Models.ViewModels.WordImportViewModel
@{
    ViewData["Title"] = "Nhập nhanh từ vựng từ Excel";
    var result = ViewBag.ImportResult as HonZi.Web.Services.ImportResultDto;
}

<div class="main-content py-10" style="background: var(--bg-surface-subtle); min-height: 85vh;">
    <div class="container container-md" style="max-width: 920px;">
        
        <!-- Header -->
        <div class="d-flex flex-wrap align-items-center justify-content-between gap-3 mb-6">
            <div>
                <a asp-action="Index" class="btn btn-ghost btn-sm mb-2" style="padding-left: 0; color: var(--text-muted);">
                    <i class="fa-solid fa-arrow-left me-1"></i> Quay lại kho từ vựng
                </a>
                <h1 class="text-ink fw-extrabold tracking-tight d-flex align-items-center gap-2" style="font-size: 1.75rem;">
                    <span style="display: inline-flex; align-items: center; justify-content: center; width: 40px; height: 40px; border-radius: 10px; background: rgba(46, 117, 89, 0.12); color: #2e7559;">
                        <i class="fa-solid fa-file-excel" style="font-size: 1.25rem;"></i>
                    </span>
                    Nhập nhanh từ vựng từ Excel / CSV
                </h1>
                <p class="text-muted mt-1" style="font-size: 0.875rem;">
                    Tải lên file bảng tính (.xlsx hoặc .csv) để thêm mới hàng loạt từ vựng HSK.
                </p>
            </div>
            <div>
                <a asp-action="DownloadTemplate" class="btn btn-outline btn-sm shadow-sm" style="background: #ffffff; color: #2e7559; border-color: #2e7559;">
                    <i class="fa-solid fa-download me-1"></i> Tải file Excel mẫu
                </a>
            </div>
        </div>

        @if (result != null)
        {
            <div class="card-plain shadow-card mb-8" style="background: #ffffff; border-radius: 16px; border: 1px solid rgba(46, 117, 89, 0.25);">
                <div class="d-flex align-items-center justify-content-between pb-4 mb-4" style="border-bottom: 1px dashed rgba(0,0,0,0.1);">
                    <div class="d-flex align-items-center gap-2">
                        <span style="width: 32px; height: 32px; border-radius: 50%; background: rgba(46, 117, 89, 0.12); color: #2e7559; display: flex; align-items: center; justify-content: center;">
                            <i class="fa-solid fa-check"></i>
                        </span>
                        <h3 class="fw-bold text-ink mb-0" style="font-size: 1.1rem;">Nạp dữ liệu hoàn tất!</h3>
                    </div>
                    <a asp-action="Index" class="btn btn-primary btn-sm">Xem danh sách từ vựng</a>
                </div>

                <div style="display: grid; grid-template-columns: repeat(3, 1fr); gap: 12px;" class="mb-4">
                    <div style="background: #f8fafc; padding: 1rem; border-radius: 12px; text-align: center; border: 1px solid #e2e8f0;">
                        <span class="text-muted fw-semibold d-block" style="font-size: 0.75rem;">TỔNG SỐ DÒNG</span>
                        <span class="text-ink fw-extrabold d-block mt-1" style="font-size: 1.5rem;">@result.TotalRows</span>
                    </div>
                    <div style="background: rgba(46, 117, 89, 0.08); padding: 1rem; border-radius: 12px; text-align: center; border: 1px solid rgba(46, 117, 89, 0.2);">
                        <span class="fw-semibold d-block" style="font-size: 0.75rem; color: #2e7559;">✓ THÀNH CÔNG</span>
                        <span class="fw-extrabold d-block mt-1" style="font-size: 1.5rem; color: #2e7559;">@result.SuccessCount</span>
                    </div>
                    <div style="background: rgba(220, 38, 38, 0.08); padding: 1rem; border-radius: 12px; text-align: center; border: 1px solid rgba(220, 38, 38, 0.2);">
                        <span class="fw-semibold d-block" style="font-size: 0.75rem; color: #dc2626;">⚠ THẤT BẠI / BỎ QUA</span>
                        <span class="fw-extrabold d-block mt-1" style="font-size: 1.5rem; color: #dc2626;">@result.FailureCount</span>
                    </div>
                </div>

                @if (result.Errors.Any())
                {
                    <div class="alert-box alert-error mb-4" style="background-color: #fef2f2; color: #991b1b; padding: 1rem; border-radius: 8px;">
                        <h4 class="fw-bold mb-2">Chi tiết các dòng bị lỗi:</h4>
                        <ul class="mb-0" style="padding-left: 1.25rem;">
                            @foreach (var err in result.Errors.Take(10))
                            {
                                <li>@err</li>
                            }
                        </ul>
                    </div>
                }
            </div>
        }

        <!-- Upload Form Card -->
        <div class="card-plain shadow-card" style="background: #ffffff; padding: 2.5rem; border-radius: 16px;">
            <form asp-action="Import" method="post" enctype="multipart/form-data">
                <div asp-validation-summary="All" class="text-danger mb-4"></div>

                <div class="form-group text-center p-8 rounded-2xl" style="border: 2px dashed #cbd5e1; background: #f8fafc;">
                    <i class="fa-solid fa-cloud-arrow-up text-primary mb-3" style="font-size: 3rem;"></i>
                    <h3 class="fw-bold text-ink" style="font-size: 1.2rem;">Chọn file Excel hoặc CSV từ máy tính</h3>
                    <p class="text-muted mt-1 mb-4" style="font-size: 0.875rem;">
                        Định dạng hỗ trợ: <strong>.xlsx, .csv</strong> (Kích thước tối đa: 10MB)
                    </p>
                    <input type="file" asp-for="File" class="form-control mx-auto" style="max-width: 360px;" accept=".xlsx,.csv" required />
                </div>

                <div class="mt-6 p-4 rounded-xl bg-secondary">
                    <h4 class="fw-bold text-ink mb-2" style="font-size: 0.9rem;">
                        <i class="fa-solid fa-circle-info text-primary me-1"></i> Quy định định dạng cột file Excel mẫu:
                    </h4>
                    <ul class="text-muted mb-0" style="font-size: 0.85rem; padding-left: 1.25rem; line-height: 1.6;">
                        <li><strong>Cột 1 (Hanzi):</strong> Chữ Hán (Bắt buộc)</li>
                        <li><strong>Cột 2 (Pinyin):</strong> Phiên âm có dấu (Bắt buộc, vd: nǐ hǎo)</li>
                        <li><strong>Cột 3 (MeaningVi):</strong> Nghĩa tiếng Việt (Bắt buộc)</li>
                        <li><strong>Cột 4 (HskLevel):</strong> Số cấp độ HSK từ 1 đến 6</li>
                        <li><strong>Cột 5 (Topic):</strong> Chủ đề từ vựng (vd: Chào hỏi, Mua sắm...)</li>
                        <li><strong>Cột 6 & 7:</strong> Câu ví dụ minh họa và dịch nghĩa câu ví dụ</li>
                    </ul>
                </div>

                <div class="d-flex justify-content-end gap-3 mt-6">
                    <a asp-action="Index" class="btn btn-outline">Hủy bỏ</a>
                    <button type="submit" class="btn btn-primary btn-lg shadow-lift">
                        <i class="fa-solid fa-upload me-1"></i> Bắt đầu Import dữ liệu
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>
