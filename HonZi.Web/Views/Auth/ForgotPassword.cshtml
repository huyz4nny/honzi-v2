@model HonZi.Web.Models.ViewModels.ForgotPasswordViewModel
@{
    ViewData["Title"] = "Quên mật khẩu";
}

<div class="main-content py-14">
    <div class="container container-sm" style="max-width: 440px;">
        <div class="card-plain shadow-card" style="padding: 2rem;">
            <div class="text-center mb-6">
                <div class="logo-icon mx-auto mb-3" style="width: 3rem; height: 3rem; font-size: 1.5rem; border-radius: var(--radius-xl); background: var(--primary); color: #fff; display: flex; align-items: center; justify-content: center; box-shadow: var(--shadow-lift); font-family: var(--font-hanzi);">
                    <i class="fa-solid fa-key" style="font-size: 1.25rem;"></i>
                </div>
                <h1 class="text-ink fw-extrabold tracking-tight" style="font-size: 1.65rem;">
                    Quên mật khẩu
                </h1>
                <p class="text-muted mt-1" style="font-size: 0.875rem;">
                    Nhập email đã đăng ký để nhận mã OTP xác thực.
                </p>
            </div>

            <form asp-controller="Auth" asp-action="ForgotPassword" method="post" class="d-grid gap-4">
                <div asp-validation-summary="All" class="text-danger" style="font-size: 0.85rem;"></div>

                <div class="form-group">
                    <label asp-for="Email" class="form-label">Email tài khoản</label>
                    <div class="input-with-icon">
                        <i class="fa-solid fa-envelope icon-left"></i>
                        <input asp-for="Email" class="form-control" placeholder="Nhập địa chỉ email của bạn" required />
                    </div>
                </div>

                <button type="submit" class="btn btn-primary btn-lg w-full shadow-lift mt-2">
                    Gửi mã xác thực OTP
                </button>

                <div class="text-center mt-3">
                    <a asp-controller="Auth" asp-action="Login" class="text-muted hover-underline" style="font-size: 0.875rem;">
                        <i class="fa-solid fa-arrow-left me-1"></i> Quay lại đăng nhập
                    </a>
                </div>
            </form>
        </div>
    </div>
</div>
