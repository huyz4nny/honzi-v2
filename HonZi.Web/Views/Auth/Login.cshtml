@model HonZi.Web.Models.ViewModels.LoginViewModel
@{
    ViewData["Title"] = "Đăng nhập";
}

<div class="main-content py-14">
    <div class="container container-sm" style="max-width: 440px;">
        <div class="card-plain shadow-card" style="padding: 2rem;">
            <!-- Header -->
            <div class="text-center mb-6">
                <img src="~/assets/logo.png" alt="HonziGo Logo" class="mx-auto mb-3" style="width: 3.25rem; height: 3.25rem; border-radius: var(--radius-xl); object-fit: cover; box-shadow: var(--shadow-lift); display: block;" />
                <h1 class="text-ink fw-extrabold tracking-tight" style="font-size: 1.65rem;">
                    Đăng nhập HonziGo
                </h1>
                <p class="text-muted mt-1" style="font-size: 0.875rem;">
                    Lưu tiến độ flashcard, bài tập listening và lịch sử kiểm tra.
                </p>
            </div>

            <!-- Tab Switcher -->
            <div class="d-grid grid-cols-2 gap-1 p-1 rounded-xl bg-secondary mb-6">
                <a asp-controller="Auth" asp-action="Login" asp-route-returnUrl="@Model?.ReturnUrl"
                   class="btn btn-sm btn-primary text-center" 
                   style="border-radius: var(--radius-md);">
                    Đăng nhập
                </a>
                <a asp-controller="Auth" asp-action="Register" asp-route-returnUrl="@Model?.ReturnUrl"
                   class="btn btn-sm btn-ghost text-center" 
                   style="border-radius: var(--radius-md);">
                    Đăng ký
                </a>
            </div>

            @if (!string.IsNullOrEmpty(Model?.ReturnUrl))
            {
                <div class="mb-5 p-3.5 rounded-xl d-flex align-items-center gap-3" style="background-color: #fef2f2; border: 1px solid #fecaca; color: #991b1b; font-size: 0.875rem;">
                    <div style="width: 36px; height: 36px; border-radius: 50%; background: #fee2e2; display: flex; align-items: center; justify-content: center; flex-shrink: 0;">
                        <i class="fa-solid fa-lock" style="color: #dc2626; font-size: 1rem;"></i>
                    </div>
                    <div>
                        <div class="fw-bold" style="color: #991b1b; font-size: 0.9rem;">Yêu cầu đăng nhập</div>
                        <div style="color: #b91c1c; font-size: 0.825rem; line-height: 1.4;">Bạn cần đăng nhập tài khoản để sử dụng tính năng này!</div>
                    </div>
                </div>
            }

            <form asp-controller="Auth" asp-action="Login" method="post" class="d-grid gap-4">
                <input type="hidden" asp-for="ReturnUrl" />
                <div asp-validation-summary="All" class="text-danger" style="font-size: 0.85rem;"></div>

                <div class="form-group">
                    <label asp-for="UsernameOrEmail" class="form-label">Tên đăng nhập hoặc Email</label>
                    <div class="input-with-icon">
                        <i class="fa-solid fa-user icon-left"></i>
                        <input asp-for="UsernameOrEmail" class="form-control" placeholder="Nhập tên đăng nhập hoặc email" required autocomplete="username" />
                    </div>
                </div>

                <div class="form-group">
                    <div class="d-flex justify-content-between align-items-center mb-1">
                        <label asp-for="Password" class="form-label" style="margin-bottom: 0;">Mật khẩu</label>
                        <a asp-controller="Auth" asp-action="ForgotPassword" class="text-muted hover-underline" style="font-size: 0.8rem;">
                            Quên mật khẩu?
                        </a>
                    </div>
                    <div class="input-with-icon">
                        <i class="fa-solid fa-lock icon-left"></i>
                        <input asp-for="Password" class="form-control" placeholder="••••••••" required autocomplete="current-password" />
                    </div>
                </div>

                <div class="d-flex align-items-center gap-2">
                    <input type="checkbox" asp-for="RememberMe" id="rememberMe" style="width: 1rem; height: 1rem;" />
                    <label for="rememberMe" class="text-muted" style="font-size: 0.85rem; margin-bottom: 0; cursor: pointer;">
                        Ghi nhớ đăng nhập
                    </label>
                </div>

                <button type="submit" class="btn btn-primary btn-lg w-full shadow-lift mt-2">
                    Đăng nhập
                </button>
            </form>
        </div>
    </div>
</div>
