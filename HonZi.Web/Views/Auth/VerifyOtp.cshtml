@{
    ViewData["Title"] = "Xác thực OTP";
}

<div class="main-content py-14">
    <div class="container container-sm" style="max-width: 440px;">
        <div class="card-plain shadow-card" style="padding: 2rem;">
            <div class="text-center mb-6">
                <div class="logo-icon mx-auto mb-3" style="width: 3rem; height: 3rem; font-size: 1.5rem; border-radius: var(--radius-xl); background: var(--primary); color: #fff; display: flex; align-items: center; justify-content: center; box-shadow: var(--shadow-lift);">
                    <i class="fa-solid fa-shield-halved" style="font-size: 1.25rem;"></i>
                </div>
                <h1 class="text-ink fw-extrabold tracking-tight" style="font-size: 1.65rem;">
                    Nhập mã xác thực OTP
                </h1>
                <p class="text-muted mt-1" style="font-size: 0.875rem;">
                    Vui lòng nhập mã 6 số đã được cấp để tiếp tục.
                </p>
            </div>

            @if (ViewBag.Error != null)
            {
                <div class="alert-box alert-error mb-4" style="background-color: #fef2f2; color: #991b1b; padding: 0.75rem; border-radius: 8px;">
                    <i class="fa-solid fa-triangle-exclamation me-1"></i> @ViewBag.Error
                </div>
            }

            <form asp-controller="Auth" asp-action="VerifyOtp" method="post" class="d-grid gap-4">
                <div class="form-group">
                    <label class="form-label">Mã OTP (6 chữ số)</label>
                    <input type="text" name="otp" class="form-control text-center fw-bold" placeholder="123456" maxlength="6" style="font-size: 1.5rem; letter-spacing: 0.5rem;" required autofocus />
                </div>

                <button type="submit" class="btn btn-primary btn-lg w-full shadow-lift mt-2">
                    Xác nhận mã OTP
                </button>
            </form>
        </div>
    </div>
</div>
